<%- include('header') %>

<div id="maincontainer">
  <main>
    <!-- action zeigt jetzt auf deine eigene Express-Route -->
    <form action="/form" method="POST">
      <fieldset>
        <legend class="legende">Kerninformationen</legend>
        <p>
          <label>Titel:
            <input
              name="name"
              maxlength="20"
              minlength="4"
              required
              id="name"
              placeholder="Titel des Tutorials"
              pattern="[A-Z].*"
            />
          </label>
        </p>
        <p>
          Sprache:
          <!-- name="sprache" (angepasst für das Backend) -->
          <select name="sprache">
            <option value="none">-</option>
            <option value="de">Deutsch</option>
            <option value="en">Englisch</option>
            <option value="es">Spanisch</option>
            <option value="fr">Französisch</option>
          </select>
        </p>
        <p>
          <label>Kategorie:
            <!-- Dynamisches Dropdown-Menü mit EJS -->
            <select name="kategorie" id="categorie" required>
              <% kategorien.forEach(function(kat) { %>
                <option value="<%= kat.name %>"><%= kat.name %></option>
              <% }) %>
            </select>
          </label>
        </p>
        <p>
          <label>Beschreibung:
            <!-- name="beschreibung" (angepasst für das Backend) -->
            <textarea
              name="beschreibung"
              minlength="40"
              rows="2"
              cols="30"
              placeholder="kurze Beschreibung des Tutorials"
            ></textarea>
          </label>
        </p>
      </fieldset>
      
      <fieldset>
        <legend class="legende">zeitliche Rahmenbedingungen und Inhalt</legend>
        <p>
          <label>Dauer:
            <!-- name="dauer" (angepasst für das Backend) -->
            <input
              type="text"
              name="dauer"
              required
              placeholder="MM:SS"
              value="00:20"
              pattern="(00:[2-5][0-9]|0[1-9]:[0-5][0-9]|1[0-5]:[0-5][0-9])"
              title="Bitte eine Dauer zwischen 00:20 und 15:59 im Format MM:SS eingeben."
            />
          </label>
        </p>
        <p>
          <label>Veröffentlichung:
            <input type="date" name="date" required />
          </label>
        </p>
        <p>
          Inhalt: <br />
          <input
            type="radio"
            name="type"
            value="text"
            required
            id="rad1"
          />Text-Tutorial
          <input
            type="radio"
            name="type"
            value="video"
            required
            id="rad2"
          />Video-Tutorial
          <br />
          <!-- name="url" (angepasst für das Backend, ehemals "content") -->
          <textarea
            required
            name="url"
            placeholder="Inhalt des Tutorials (URL oder Link)"
            rows="10"
            cols="40"
            id="content"
          ></textarea>
        </p>
      </fieldset>
      <input type="submit" value="Erstellen" id="erstellen" />
    </form>
  </main>
</div>

<!-- Dein spezifisches Formular-Skript wird nur auf dieser Seite geladen -->
<script src="/js/form.js"></script>

<%- include('footer') %>